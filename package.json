{
  "name": "@hexlet/code",
  "version": "0.0.1",
  "description": "Validator",
  "bin": {
    "nodejs-package": "bin/validator.js"
  },
  "simple-git-hooks": {
    "pre-push": "npx lint-staged"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint && oxfmt --ignore-path=.oxfmtignore --check",
    "lint:fix": "oxfmt --ignore-path=.oxfmtignore && oxlint --fix"
  },
  "author": "Anton Shipilov",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "es-toolkit": "^1.45.1"
  },
  "lint-staged": {
    "*.js": [
      "oxfmt --ignore-path=.oxfmtignore",
      "oxlint --fix"
    ]
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "lint-staged": "^16.4.0",
    "npm-check-updates": "^19.6.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "release-it": "^21.0.1",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^3.2.4"
  }
}
